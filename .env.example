# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

LRS_DATABASE_URL=postgresql://lrs:lrs@localhost:5432/lrs
LRS_JWT_SECRET=change-me-to-a-long-random-string
LRS_JWT_EXPIRE_MINUTES=60
LRS_CORS_ORIGINS=["http://localhost:5173"]
# Redis cache; leave empty to run without a cache
LRS_REDIS_URL=redis://localhost:6379/0
LRS_CACHE_TTL_SECONDS=300
