# What `docker build` must NOT send to the builder (the "build context").
# Smaller context = faster build; and secrets can never end up in an image layer.

# secrets and local config
.env
.env.*

# local environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# not needed to run the app
.git/
tests/
requirements-dev.txt
pyproject.toml
*.md
LICENSE
Dockerfile
.dockerignore
